#!/bin/sh
# Refuse commits that carry signing material. DevEco Studio rewrites build-profile.json5
# with certificate paths and encrypted passwords whenever signing is (re)configured;
# move that block to signing.local.json5 instead (see docs/BUILD.md).
if git diff --cached -U0 -- build-profile.json5 | grep -E '^\+.*"(keyPassword|storePassword|certpath|storeFile)"' >/dev/null; then
  echo "pre-commit: build-profile.json5 contains signing material." >&2
  echo "Move signingConfigs to signing.local.json5 and leave \"signingConfigs\": [] (docs/BUILD.md)." >&2
  exit 1
fi
